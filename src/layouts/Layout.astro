---
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TechFormations — Formations DevOps, Cloud & Développement',
  description = 'Plateforme de formations techniques premium pour développeurs. Maîtrisez Docker, DevOps, CI/CD, Kubernetes, Cloud et l\'industrialisation logicielle avec des formations orientées terrain.',
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0F1E" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="formation devops, formation docker, formation kubernetes, formation ci/cd, formation cloud, formation développeur, linux, nginx, github actions" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://techformations.kandorlab.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Navbar client:load pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
